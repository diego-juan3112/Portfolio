# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo para el chat y para el análisis de fit (puedes cambiarlos sin tocar código)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FIT_MODEL=gemini-3.8-flash

# Correo (https://resend.com): clave y destinatarios
RESEND_API_KEY=
CONTACT_TO_EMAIL=jdiegohenao04@outlook.com
# Remitente verificado en Resend; para pruebas: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile (anti-bot). Vacío = desactivado en desarrollo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública del sitio (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
