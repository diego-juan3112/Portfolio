# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Cadena de modelos (separados por coma): se prueba el primero y, si está saturado, sin cuota
# o tarda más de 8 s (chat) / 15 s (fit), el siguiente.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_FIT_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Correo (https://resend.com): clave y destinatarios
RESEND_API_KEY=
CONTACT_TO_EMAIL=jdiegohenao04@outlook.com
# Remitente verificado en Resend; para pruebas: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile (anti-bot). Vacío = desactivado.
# Ojo: el formulario aún no muestra el widget; si defines TURNSTILE_SECRET_KEY, el envío fallará.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública del sitio (enlace canónico y Open Graph). Se fija en build: cámbiala y vuelve a compilar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
